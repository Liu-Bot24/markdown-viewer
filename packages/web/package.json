{
  "name": "@mdv/web",
  "productName": "MD Viewer Web",
  "version": "1.0.0",
  "description": "Web edition of MD Viewer for a NAS or server: browse, search and read Markdown folders and chat archives in the browser",
  "private": true,
  "type": "module",
  "main": "src/server/main.js",
  "scripts": {
    "build": "node scripts/build.mjs",
