{
 "outDir": "test/output/selftest-folder",
 "steps": [
  {
   "name": "theme-light",
   "do": "setTheme",
   "theme": "light",
   "expect": {
    "dark": false
   }
  },
  {
   "name": "wide-window",
   "do": "windowSize",
   "width": 2400,
   "height": 1300,
   "expect": {
    "cssWidth": {
     "min": 2300
    }
   }
  },
  {
   "name": "write 索引.md",
   "do": "writeFile",
   "path": "${tmp}\\fv\\索引.md",
   "content": "# 测试会话\n\n[图片](图片/) · [语音](语音/) · [文件](文件/)\n"
  },
  {
   "name": "write 图片\\预览\\p.png",
   "do": "writeFile",
   "path": "${tmp}\\fv\\图片\\预览\\p.png",
   "base64": "iVBORw0KGgoAAAANSUhEUgAAACgAAAAeCAIAAADRv8uKAAAAGklEQVR4nO3BMQEAAADCoPVP7W8GoAAAAOANDi4AAWSBPj4AAAAASUVORK5CYII="
  },
  {
   "name": "write 图片\\2019-02-12_142201_图片_000004.png",
   "do": "writeFile",
   "path": "${tmp}\\fv\\图片\\2019-02-12_142201_图片_000004.png",
   "base64": ""
  },
  {
   "name": "write 图片\\2019-05-01_080000_图片_000010.png",
   "do": "writeFile",
   "path": "${tmp}\\fv\\图片\\2019-05-01_080000_图片_000010.png",
   "base64": ""
  },
  {
   "name": "write 图片\\2020-11-29_204017_图片_005227.png",
   "do": "writeFile",
   "path": "${tmp}\\fv\\图片\\2020-11-29_204017_图片_005227.png",
   "base64": ""
  },
  {
   "name": "write 图片\\2020-12-06_212106_图片_005439.png",
   "do": "writeFile",
   "path": "${tmp}\\fv\\图片\\2020-12-06_212106_图片_005439.png",
   "base64": ""
  },
  {
   "name": "write 图片\\2021-03-07_122724_图片_010313.png",
   "do": "writeFile",
   "path": "${tmp}\\fv\\图片\\2021-03-07_122724_图片_010313.png",
   "base64": ""
  },
  {
   "name": "write 图片\\2021-03-07_122749_图片_010314.png",
   "do": "writeFile",
   "path": "${tmp}\\fv\\图片\\2021-03-07_122749_图片_010314.png",
   "base64": ""
  },
  {
   "name": "write 语音\\2019-03-12_224515_语音_000124.wav",
   "do": "writeFile",
   "path": "${tmp}\\fv\\语音\\2019-03-12_224515_语音_000124.wav",
   "base64": ""
  },
  {
   "name": "write 语音\\2019-03-12_224515_语音_000124.txt",
   "do": "writeFile",
   "path": "${tmp}\\fv\\语音\\2019-03-12_224515_语音_000124.txt",
   "content": "测试转写内容\n"
  },
  {
   "name": "write 语音\\2019-03-30_123049_语音_000125.wav",
   "do": "writeFile",
   "path": "${tmp}\\fv\\语音\\2019-03-30_123049_语音_000125.wav",
   "base64": ""
  },
  {
   "name": "write 文件\\说明.txt",
   "do": "writeFile",
   "path": "${tmp}\\fv\\文件\\说明.txt",
   "content": "第一行\n第二行\n"
  },
  {
   "name": "write 文件\\page.html",
   "do": "writeFile",
   "path": "${tmp}\\fv\\文件\\page.html",
   "content": "<html><head><title>x</title></head><body><p>网页正文</p><script>parent.document.title = \"SCRIPT RAN\"</script></body></html>"
  },
  {
   "name": "write 文件\\data.bin",
   "do": "writeFile",
   "path": "${tmp}\\fv\\文件\\data.bin",
   "base64": "AAECAw=="
  },
  {
   "name": "open-index",
   "do": "open",
   "path": "${tmp}\\fv\\索引.md",
   "expect": {
    "view.error": null
   }
  },
  {
   "name": "click-pictures-link",
   "do": "mouse",
   "selector": ".doc-root.active article a:nth-of-type(1)",
   "settle": 300
  },
  {
   "name": "picture-folder",
   "do": "fvWait",
   "kind": "folder",
   "settle": 1500,
   "expect": {
    "layout": "grid",
    "total": 7,
    "items": 6,
    "chips": "📁 预览",
    "years": "2019,2020,2021",
    "imgsLoaded": 6,
    "cols": {
     "min": 7
    },
    "status": "1 个文件夹 · 6 个文件",
    "bodyWidth": {
     "min": 1500
    }
   },
   "screenshot": true
  },
  {
   "name": "click-thumbnail",
   "do": "mouse",
   "selector": ".doc-root.active .fv-tile",
   "settle": 800,
   "probe": true,
   "expect": {
    "open": true,
    "fits": true
   }
  },
  {
   "name": "viewer-first",
   "do": "fvState",
   "expect": {
    "lb.count": "1 / 6",
    "lb.caption": "2019-02-12_142201_图片_000004.png"
   }
  },
  {
   "name": "arrow-right",
   "do": "keys",
   "keys": [
    "Right"
   ],
   "settle": 600
  },
  {
   "name": "viewer-second",
   "do": "fvState",
   "expect": {
    "lb.count": "2 / 6",
    "lb.caption": "2019-05-01_080000_图片_000010.png"
   }
  },
  {
   "name": "next-button",
   "do": "mouse",
   "selector": ".lb-side.next",
   "settle": 600
  },
  {
   "name": "viewer-third",
   "do": "fvState",
   "expect": {
    "lb.count": "3 / 6",
    "lb.caption": "2020-11-29_204017_图片_005227.png"
   },
   "screenshot": true
  },
  {
   "name": "arrow-left",
   "do": "keys",
   "keys": [
    "Left"
   ],
   "settle": 600
  },
  {
   "name": "viewer-back-to-second",
   "do": "fvState",
   "expect": {
    "lb.count": "2 / 6"
   }
  },
  {
   "name": "esc",
   "do": "keys",
   "keys": [
    "Escape"
   ]
  },
  {
   "name": "viewer-closed",
   "do": "fvState",
   "expect": {
    "lb.open": false,
    "kind": "folder"
   }
  },
  {
   "name": "back-to-index",
   "do": "back",
   "expect": {
    "view.path": "${tmp}\\fv\\索引.md"
   }
  },
  {
   "name": "click-voice-link",
   "do": "mouse",
   "selector": ".doc-root.active article a:nth-of-type(2)",
   "settle": 300
  },
  {
   "name": "voice-folder",
   "do": "fvWait",
   "kind": "folder",
   "settle": 800,
   "expect": {
    "layout": "list",
    "total": 3,
    "items": 2,
    "transcripts": "测试转写内容",
    "names": "2019-03-12_224515_语音_000124.wav|2019-03-30_123049_语音_000125.wav"
   },
   "screenshot": true
  },
  {
   "name": "play-row",
   "do": "mouse",
   "selector": ".doc-root.active .fv-audio",
   "settle": 300
  },
  {
   "name": "playing",
   "do": "fvState",
   "expect": {
    "playing": true
   }
  },
  {
   "name": "back-to-index-2",
   "do": "back",
   "expect": {
    "view.path": "${tmp}\\fv\\索引.md"
   }
  },
  {
   "name": "click-files-link",
   "do": "mouse",
   "selector": ".doc-root.active article a:nth-of-type(3)",
   "settle": 300
  },
  {
   "name": "file-folder",
   "do": "fvWait",
   "kind": "folder",
   "expect": {
    "layout": "list",
    "items": 3
   }
  },
  {
   "name": "click-text",
   "do": "mouse",
   "selector": ".doc-root.active .fv-row[data-kind=\"text\"]",
   "settle": 300
  },
  {
   "name": "text-view",
   "do": "fvWait",
   "kind": "file",
   "expect": {
    "text": "第一行\n第二行\n",
    "frame": false,
    "modeSeg": "none",
    "status": "UTF-8 · 20 B · 3 行"
   }
  },
  {
   "name": "back-to-files",
   "do": "back"
  },
  {
   "name": "files-again",
   "do": "fvWait",
   "kind": "folder",
   "expect": {
    "items": 3
   }
  },
  {
   "name": "click-page",
   "do": "mouse",
   "selector": ".doc-root.active .fv-row[data-kind=\"html\"]",
   "settle": 300
  },
  {
   "name": "page-view",
   "do": "fvWait",
   "kind": "file",
   "settle": 1000,
   "expect": {
    "frame": true,
    "sandbox": "",
    "title": "page.html - MD Viewer"
   },
   "screenshot": true
  }
 ]
}
